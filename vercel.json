{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/:lang(en|he|sr)", "destination": "/", "permanent": true },
    { "source": "/:lang(en|he|sr)/:path*", "destination": "/:path*", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
